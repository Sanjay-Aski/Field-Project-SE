# .env.sample – Configuration template for your application
# ------------------------------------------------------------------
# IMPORTANT: This file contains example values only. Replace them with
# your actual secrets before running the app. Do NOT commit the real
# secrets to version control.

# -------------------------------------------------------------
# 1️⃣ Server
# -------------------------------------------------------------
PORT=5000                         # The port your server will bind to (e.g., 3000, 5000)

# -------------------------------------------------------------
# 2️⃣ MongoDB
# -------------------------------------------------------------
MONGO_URI=mongodb://localhost:27017/yourdb   # Connection string to your MongoDB instance
# Example: MONGO_URI=mongodb+srv://user:pass@cluster0.mongodb.net/mydb?retryWrites=true&w=majority

# -------------------------------------------------------------
# 3️⃣ JWT (JSON Web Token)
# -------------------------------------------------------------
JWT_SECRET=your_jwt_secret_here    # Keep this secret safe; used to sign JWTs

# -------------------------------------------------------------
# 4️⃣ Email (SMTP) – for sending notifications, password resets, etc.
# -------------------------------------------------------------
EMAIL_USER=you@example.com         # The email address you will send from
EMAIL_PASS=your_email_app_password # App password or account password

# -------------------------------------------------------------
# 5️⃣ Admin Key – used for privileged routes or initial setup
# -------------------------------------------------------------
ADMIN_KEY=your_admin_key           # Very secret; e.g., 123456 or a random string

# ------------------------------------------------------------------
# End of .env.sample
